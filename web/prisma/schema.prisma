generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model RawArticle {
  id            String   @id @default(uuid())
  environment   String   @default("prod")
  canonicalUrl  String
  hash          String?
  title         String
  snippet       String?
  source        String?
  publishedAt   DateTime?
  origin        String?
  enhancedQuery String?
  createdAt     DateTime @default(now())

  memberships   ClusterMembership[]

  @@unique([environment, canonicalUrl])
  @@index([environment, publishedAt])
}

model TopicCluster {
  id             String   @id @default(uuid())
  environment    String   @default("prod")
  searchPhrase   String?
  objectiveTitle String?
  summary        String?
  analysisJson   Json?
  embedding      Bytes?
  createdAt      DateTime @default(now())
  lastUpdatedAt  DateTime @default(now())
  status         String   @default("active")

  memberships    ClusterMembership[]

  @@index([environment, lastUpdatedAt])
}

model ClusterMembership {
  id          String       @id @default(uuid())
  environment String       @default("prod")
  clusterId   String
  articleId   String

  cluster     TopicCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  article     RawArticle   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([environment, clusterId, articleId])
  @@index([environment, clusterId])
}

model AnalysisRun {
  id          String   @id @default(uuid())
  environment String   @default("prod")
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  statsJson   Json?
  error       String?
}
