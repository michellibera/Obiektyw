# API Keys Template
# Copy this file to .env.local and fill in your actual API keys

# LLM Provider
# Options: azure | anthropic
LLM_PROVIDER=azure

# Azure OpenAI (Foundry)
AZURE_OPENAI_ENDPOINT=https://miche-m7hudro1-eastus2.services.ai.azure.com
AZURE_OPENAI_API_VERSION=2024-05-01-preview
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT=grok-4-fast-reasoning

# Anthropic Claude API Key
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Brave Search API Key
# Get your key from: https://brave.com/search/api/
BRAVE_API_KEY=your_brave_api_key_here

# Supabase / Postgres (Prisma)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Data environment for DB filtering: dev | prod
DATA_ENV=prod

# Cron secret for /api/cron/analyze (optional)
CRON_SECRET=your_cron_secret_here

# Feature Flags
# Set to 'true' to use mock data instead of real Brave News API calls
USE_MOCK_NEWS=false
# Set to 'true' to use mock LLM analysis instead of live LLM calls
USE_MOCK_ANALYSIS=false
